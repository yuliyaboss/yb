# Public site URL, used for canonical links, OG tags and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://primeera.pl

# Google Analytics 4 — leave empty to keep analytics scripts disabled entirely.
NEXT_PUBLIC_GA4_ID=

# Meta Pixel (client-side) — leave empty to keep the pixel script disabled entirely.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (server-side relay) — both required together.
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
